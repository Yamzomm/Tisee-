<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Tisee</title>

  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:wght@400;700&family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Inter", Arial, sans-serif;
      background: #efe7dc;
      color: #332c27;
    }

    /* =========================================================
       HEADER / NAVBAR
       ========================================================= */

    .site-header {
      position: relative;
      isolation: isolate;
      overflow: hidden;

      width: 100%;
      min-height: 124px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 5vw;

      color: rgba(240, 227, 200, 0.92);

      /*
        Rock image
      */
      background-image: url("/images/rock-texture.jpg");
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center 38%;

      /*
        Lower contrast / softer than realistic photography
      */
      box-shadow:
        inset 0 -1px 0 rgba(255, 255, 255, 0.04),
        inset 0 -12px 28px rgba(0, 0, 0, 0.14);

      z-index: 100;
    }

    /* =========================================================
       WARM DARK OVERLAY
       ========================================================= */

    .site-header::before {
      content: "";

      position: absolute;
      inset: 0;

      z-index: -2;
      pointer-events: none;

      /*
        Multiple overlays:
        1. dark warm layer
        2. uneven weathering
        3. muted brown undertone
      */
      background:
        radial-gradient(
          circle at 18% 28%,
          rgba(146, 107, 72, 0.12),
          transparent 30%
        ),

        radial-gradient(
          circle at 77% 24%,
          rgba(0, 0, 0, 0.18),
          transparent 34%
        ),

        radial-gradient(
          circle at 54% 90%,
          rgba(137, 103, 72, 0.08),
          transparent 28%
        ),

        linear-gradient(
          rgba(24, 22, 20, 0.46),
          rgba(24, 22, 20, 0.50)
        );

      backdrop-filter: blur(1.2px);
    }

    /* =========================================================
       GRAIN / PARTICLES
       ========================================================= */

    .site-header::after {
      content: "";

      position: absolute;
      inset: 0;

      z-index: -1;
      pointer-events: none;

      opacity: 0.20;

      /*
        Several particle sizes and spacing
        to avoid obvious uniform digital noise
      */
      background-image:

        radial-gradient(
          circle,
          rgba(240, 227, 200, 0.38) 0 0.45px,
          transparent 0.8px
        ),

        radial-gradient(
          circle,
          rgba(5, 4, 3, 0.42) 0 0.65px,
          transparent 1px
        ),

        radial-gradient(
          circle,
          rgba(214, 182, 140, 0.22) 0 0.8px,
          transparent 1.15px
        ),

        radial-gradient(
          circle,
          rgba(0, 0, 0, 0.18) 0 0.5px,
          transparent 0.85px
        );

      background-size:
        13px 17px,
        19px 23px,
        29px 31px,
        41px 37px;

      background-position:
        2px 5px,
        11px 9px,
        7px 15px,
        17px 3px;

      mix-blend-mode: soft-light;
    }

    /* =========================================================
       HEADER INNER
       ========================================================= */

    .header-inner {
      position: relative;
      z-index: 2;

      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* =========================================================
       BRAND
       ========================================================= */

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-mark {
      width: 34px;
      height: 34px;

      border-radius: 50%;

      border: 1px solid rgba(240, 227, 200, 0.28);

      background:
        radial-gradient(
          circle at 35% 35%,
          rgba(240, 227, 200, 0.14),
          transparent 48%
        ),
        rgba(240, 227, 200, 0.05);
    }

    .brand-name {
      font-family: "Cormorant Garamond", Georgia, serif;

      font-size: 24px;
      font-weight: 600;

      letter-spacing: 0.12em;

      color: #eee2c9;

      text-decoration: none;

      text-shadow:
        0 2px 8px rgba(0, 0, 0, 0.28);
    }

    /* =========================================================
       NAVIGATION
       ========================================================= */

    .main-nav {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .main-nav a {
      position: relative;

      padding: 10px 0;

      font-family: "Inter", Arial, sans-serif;

      font-size: 13px;
      font-weight: 500;

      letter-spacing: 0.12em;

      color: rgba(240, 227, 200, 0.84);

      text-decoration: none;

      transition:
        color 180ms ease,
        opacity 180ms ease;
    }

    .main-nav a:hover {
      color: #f6ead0;
    }

    /* =========================================================
       NAV HOVER UNDERLINE
       ========================================================= */

    .main-nav a::after {
      content: "";

      position: absolute;

      left: 0;
      bottom: 5px;

      width: 100%;
      height: 1px;

      background: rgba(240, 227, 200, 0.72);

      transform: scaleX(0);
      transform-origin: left;

      transition: transform 220ms ease;
    }

    .main-nav a:hover::after {
      transform: scaleX(1);
    }

    /* =========================================================
       CTA
       ========================================================= */

    .main-nav .nav-cta {
      padding: 10px 16px;

      border: 1px solid rgba(240, 227, 200, 0.22);

      border-radius: 999px;

      background: rgba(240, 227, 200, 0.05);
    }

    .main-nav .nav-cta::after {
      display: none;
    }

    .main-nav .nav-cta:hover {
      background: rgba(240, 227, 200, 0.09);
    }

    /* =========================================================
       ARTISTIC PAGE HEADINGS
       ========================================================= */

    /*
      Only large artistic headings use Averia Serif Libre
    */

    h1,
    h2,
    .hero-title,
    .section-title,
    .artistic-title {
      font-family: "Averia Serif Libre", Georgia, serif;

      font-weight: 700;

      letter-spacing: 0.01em;
    }

    /*
      Example:
      hero title
    */

    .hero-title {
      font-size: clamp(42px, 6vw, 86px);

      line-height: 0.95;

      color: #332c27;

      margin: 0;
    }

    /* =========================================================
       REGULAR TEXT
       ========================================================= */

    p,
    .body-copy,
    .section-copy,
    .button-text {
      font-family: "Inter", Arial, sans-serif;
    }

    /* =========================================================
       OPTIONAL SERIF SUBHEADINGS
       ========================================================= */

    /*
      If you want some smaller headings to feel elegant
      but not too artistic, use Cormorant Garamond.
    */

    .editorial-heading,
    h3 {
      font-family: "Cormorant Garamond", Georgia, serif;

      font-weight: 600;
    }

    /* =========================================================
       EXAMPLE PAGE CONTENT
       This part can be removed in the actual project.
       ========================================================= */

    .page-demo {
      min-height: 700px;

      padding: 70px 6vw;

      background: #efe7dc;
    }

    .page-demo .hero-title {
      max-width: 800px;
    }

    .page-demo p {
      max-width: 620px;

      margin-top: 24px;

      font-size: 16px;

      line-height: 1.7;

      color: #665b50;
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 768px) {

      .site-header {
        min-height: 108px;

        padding: 0 20px;

        background-position: center center;
      }

      .brand-name {
        font-size: 20px;
      }

      .main-nav {
        gap: 16px;
      }

      .main-nav a {
        font-size: 11px;
      }

      /*
        If you already have a mobile hamburger menu,
        keep your current logic instead of using this.
      */

      .main-nav a:nth-child(3) {
        display: none;
      }

      .main-nav .nav-cta {
        padding: 8px 11px;
      }
    }

    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

      .main-nav a,
      .main-nav a::after {
        transition: none;
      }
    }

  </style>
</head>

<body>

  <!-- =======================================================
       HEADER
       ======================================================= -->

  <header class="site-header">

    <div class="header-inner">

      <!-- Brand -->
      <div class="brand-wrap">

        <div class="brand-mark"></div>

        <a
          href="/"
          class="brand-name"
        >
          TISEE
        </a>

      </div>

      <!-- Navigation -->
      <nav class="main-nav">

        <a href="/">
          HOME
        </a>

        <a href="#stories">
          STORIES
        </a>

        <a href="#map">
          MAP
        </a>

        <a
          href="#join"
          class="nav-cta"
        >
          JOIN
        </a>

      </nav>

    </div>

  </header>


  <!-- =======================================================
       EXAMPLE PAGE CONTENT
       Remove this section if integrating into existing website.
       ======================================================= -->

  <main class="page-demo">

    <h1 class="hero-title">
      Meet Tibet Through Its People
    </h1>

    <p>
      Stories, routes and local experiences shaped around people,
      place and everyday culture.
    </p>

  </main>

</body>
</html>
