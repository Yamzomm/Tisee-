<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Tisee</title>

  <!-- Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Rubik+Dirt&family=ZCOOL+KuaiLe&family=Inter:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&display=swap"
    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    body {
      background: #e8dfd3;
      color: #342d27;
      font-family: "Inter", "Noto Sans SC", Arial, sans-serif;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .site-header {
      position: relative;
      isolation: isolate;
      overflow: hidden;

      width: 100%;
      min-height: 520px;

      padding: 30px 5vw 54px;

      background:
        radial-gradient(
          circle at 18% 28%,
          rgba(126, 95, 67, 0.24),
          transparent 28%
        ),

        radial-gradient(
          circle at 78% 20%,
          rgba(8, 7, 6, 0.24),
          transparent 34%
        ),

        radial-gradient(
          circle at 56% 88%,
          rgba(129, 98, 69, 0.13),
          transparent 30%
        ),

        linear-gradient(
          110deg,
          #2a2522,
          #3a3029 43%,
          #322a25 72%,
          #28231f
        );

      box-shadow:
        inset 0 -18px 32px rgba(0, 0, 0, 0.16);
    }

    /* =========================================================
       SOFT WEATHERING / BLUR
       ========================================================= */

    .site-header::before {
      content: "";

      position: absolute;
      inset: -14px;

      z-index: -2;
      pointer-events: none;

      background:
        radial-gradient(
          ellipse at 13% 38%,
          rgba(205, 163, 116, 0.08),
          transparent 31%
        ),

        radial-gradient(
          ellipse at 48% 66%,
          rgba(0, 0, 0, 0.15),
          transparent 34%
        ),

        radial-gradient(
          ellipse at 82% 42%,
          rgba(188, 143, 99, 0.07),
          transparent 29%
        );

      filter: blur(9px);
    }

    /* =========================================================
       ROCK GRAIN
       ========================================================= */

    .site-header::after {
      content: "";

      position: absolute;
      inset: 0;

      z-index: -1;
      pointer-events: none;

      opacity: 0.22;

      mix-blend-mode: soft-light;

      background-image:

        radial-gradient(
          circle,
          rgba(239, 221, 190, 0.40) 0 0.45px,
          transparent 0.8px
        ),

        radial-gradient(
          circle,
          rgba(0, 0, 0, 0.44) 0 0.65px,
          transparent 1px
        ),

        radial-gradient(
          circle,
          rgba(218, 188, 150, 0.22) 0 0.8px,
          transparent 1.15px
        );

      background-size:
        13px 17px,
        19px 23px,
        31px 29px;

      background-position:
        2px 5px,
        11px 9px,
        7px 15px;
    }

    /* =========================================================
       NAVBAR
       ========================================================= */

    .navbar {
      position: relative;
      z-index: 2;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;
    }

    .brand {
      color: #eee2c9;

      font-family: "Inter", "Noto Sans SC", sans-serif;

      font-size: 18px;
      font-weight: 600;

      letter-spacing: 0.16em;

      text-decoration: none;
    }

    .nav-links {
      display: flex;
      align-items: center;

      gap: 28px;
    }

    .nav-links a {
      position: relative;

      color: rgba(240, 227, 200, 0.78);

      font-family: "Inter", "Noto Sans SC", sans-serif;

      font-size: 12px;
      font-weight: 500;

      letter-spacing: 0.12em;

      text-decoration: none;

      transition: color 180ms ease;
    }

    .nav-links a:hover {
      color: #f6ead0;
    }

    /* Hover underline */

    .nav-links a::after {
      content: "";

      position: absolute;

      left: 0;
      bottom: -6px;

      width: 100%;
      height: 1px;

      background: rgba(240, 227, 200, 0.72);

      transform: scaleX(0);
      transform-origin: left;

      transition: transform 220ms ease;
    }

    .nav-links a:hover::after {
      transform: scaleX(1);
    }

    /* =========================================================
       HERO AREA
       ========================================================= */

    .hero {
      position: relative;
      z-index: 2;

      margin-top: 100px;
    }

    /* =========================================================
       ENGLISH TITLE
       Rubik Dirt
       ========================================================= */

    .hero-title-en {
      margin: 0;

      max-width: 900px;

      font-family: "Rubik Dirt", system-ui, sans-serif;

      font-size: clamp(58px, 7vw, 104px);

      font-weight: 400;

      line-height: 0.92;

      letter-spacing: 0.01em;

      color: #ead9b9;

      text-shadow:
        0 2px 8px rgba(0, 0, 0, 0.14);
    }

    /* =========================================================
       CHINESE TITLE
       ZCOOL KuaiLe + ROCK TEXTURE
       ========================================================= */

    .hero-title-cn {
      margin: 34px 0 0;

      display: inline-block;

      font-family:
        "ZCOOL KuaiLe",
        "Noto Sans SC",
        sans-serif;

      font-size: clamp(44px, 5.5vw, 76px);

      font-weight: 400;

      line-height: 1.04;

      letter-spacing: 0.02em;

      color: transparent;

      /*
        Rock / mineral powder texture
        clipped inside the Chinese characters
      */
      background:

        radial-gradient(
          circle at 15% 35%,
          #f0dfbd 0 6%,
          transparent 7%
        ),

        radial-gradient(
          circle at 72% 40%,
          #b99b72 0 5%,
          transparent 6%
        ),

        linear-gradient(
          90deg,
          #ead9b9,
          #c5a57b 48%,
          #eddcbf
        );

      -webkit-background-clip: text;
      background-clip: text;

      text-shadow:
        0 1px 0 rgba(255, 255, 255, 0.025);
    }

    /* =========================================================
       SUBTITLE / BODY TEXT
       ========================================================= */

    .hero-subtitle {
      margin-top: 24px;

      max-width: 640px;

      color: rgba(240, 227, 200, 0.72);

      font-family:
        "Inter",
        "Noto Sans SC",
        Arial,
        sans-serif;

      font-size: 15px;

      line-height: 1.75;
    }

    /* =========================================================
       OPTIONAL BUTTON
       ========================================================= */

    .hero-button {
      display: inline-block;

      margin-top: 28px;

      padding: 11px 18px;

      border: 1px solid rgba(240, 227, 200, 0.24);

      border-radius: 999px;

      color: rgba(240, 227, 200, 0.88);

      background: rgba(240, 227, 200, 0.05);

      font-family: "Inter", sans-serif;

      font-size: 12px;

      letter-spacing: 0.12em;

      text-decoration: none;

      transition:
        background 180ms ease,
        color 180ms ease;
    }

    .hero-button:hover {
      color: #f6ead0;

      background: rgba(240, 227, 200, 0.10);
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 768px) {

      .site-header {
        min-height: 460px;

        padding:
          24px
          22px
          42px;
      }

      .brand {
        font-size: 16px;
      }

      .nav-links {
        gap: 14px;
      }

      .nav-links a {
        font-size: 10px;
      }

      .hero {
        margin-top: 82px;
      }

      .hero-title-en {
        line-height: 0.96;
      }

      .hero-title-cn {
        margin-top: 26px;
      }
    }

    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

      .nav-links a,
      .nav-links a::after,
      .hero-button {
        transition: none;
      }
    }

  </style>
</head>

<body>

  <header class="site-header">

    <!-- Navbar -->
    <nav class="navbar">

      <a
        href="/"
        class="brand"
      >
        TISEE
      </a>

      <div class="nav-links">

        <a href="/">
          HOME
        </a>

        <a href="#stories">
          STORIES
        </a>

        <a href="#map">
          MAP
        </a>

        <a href="#join">
          JOIN
        </a>

      </div>

    </nav>


    <!-- Hero -->
    <section class="hero">

      <h1 class="hero-title-en">
        Meet Tibet
        <br>
        Through Its People
      </h1>


      <h2 class="hero-title-cn">
        通过人，遇见西藏
      </h2>


      <p class="hero-subtitle">

        Stories, routes and local experiences shaped around people,
        place and everyday culture.

        <br>

        在真实的人与日常生活中，重新认识一片土地。

      </p>


      <a
        href="#stories"
        class="hero-button"
      >
        EXPLORE STORIES
      </a>

    </section>

  </header>

</body>
</html>
